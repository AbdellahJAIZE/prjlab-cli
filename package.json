{
  "name": "prjlab-cli",
  "version": "0.0.0-development",
  "private": true,
  "description": "PrjLab CLI foundation; not released.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "bin": {
    "prj": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "LOGIN.md",
    "SYNC.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "prettier": "3.9.8",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@azure/msal-node": "6.0.1",
    "@azure/msal-node-extensions": "5.5.1",
    "ignore": "7.0.9"
  }
}
