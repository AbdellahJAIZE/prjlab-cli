{
  "name": "prjlab-cli",
  "version": "0.6.0",
  "description": "PrjLab command-line client: push, pull and clone your projects with their context.",
  "license": "MIT",
  "homepage": "https://prjlab.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdellahJAIZE/prjlab-cli.git"
  },
  "bugs": {
    "url": "https://github.com/AbdellahJAIZE/prjlab-cli/issues"
  },
  "keywords": [
    "prjlab",
    "cli",
    "claude-code",
    "project-context",
    "sync",
    "snapshot"
  ],
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "bin": {
    "prj": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "LOGIN.md",
    "SYNC.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "prettier": "3.9.8",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@azure/msal-node": "6.0.1",
    "@napi-rs/keyring": "2.1.0",
    "ignore": "7.0.9"
  }
}
